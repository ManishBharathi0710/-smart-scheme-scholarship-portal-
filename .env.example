# ==============================================================================
# Smart Scheme & Scholarship Recommendation Portal - Complete Environment Matrix
# ==============================================================================
# NOTE: Never commit production credentials, passwords, or API keys into git.
# Duplicate this file as .env or set variables within your hosting environment.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development # Options: development | staging | production | test
PORT=5001
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info # Options: trace | debug | info | warn | error | fatal

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (POSTGRESQL / PRISMA)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_scheme_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (MODULE 1 & 2)
# ------------------------------------------------------------------------------
# In production, generate cryptographically random 64-char strings: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_jwt
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_64_char_secret_key_for_refresh
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=60
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in ms
RATE_LIMIT_MAX=100 # Maximum requests per window

# ------------------------------------------------------------------------------
# 4. DOCUMENT STORAGE & OCR ENGINE (MODULE 6)
# ------------------------------------------------------------------------------
DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_STORAGE_PATH=uploads/documents
DOCUMENT_SIGNED_URL_EXPIRES_SECONDS=300
OCR_CONFIDENCE_THRESHOLD=0.7

# ------------------------------------------------------------------------------
# 5. NOTIFICATIONS & EMAIL DELIVERY (MODULE 7)
# ------------------------------------------------------------------------------
NOTIFICATION_DEADLINE_THRESHOLDS=7,3,1,0
NOTIFICATION_RETENTION_DAYS=180
NOTIFICATION_CLEANUP_BATCH_SIZE=100
EMAIL_PROVIDER=LOG # Options: LOG | MOCK | SMTP
EMAIL_FROM=notifications@smartschemes.gov.in
NOTIFICATION_MAX_EMAIL_RETRIES=3

# ------------------------------------------------------------------------------
# 6. AI ASSISTANT & GROUNDED GUIDANCE (MODULE 8)
# ------------------------------------------------------------------------------
AI_PROVIDER=MOCK # Options: MOCK | GEMINI | OPENAI
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000
AI_MAX_CONVERSATION_MESSAGES=20
AI_REQUESTS_PER_MINUTE=30
AI_CONVERSATION_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 7. ANALYTICS, AUDIT & OBSERVABILITY (MODULE 9 & 10)
# ------------------------------------------------------------------------------
ANALYTICS_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
ANALYTICS_MAX_EXPORT_ROWS=10000
ANALYTICS_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 8. FRONTEND BROWSER CONFIGURATION (VITE)
# (Only variables prefixed with VITE_ are exposed to the browser client)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_PORTAL_NAME=Smart Scheme & Scholarship Recommendation Portal
VITE_APP_ENV=development
