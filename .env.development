# Development Environment Configuration
NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_scheme_db?schema=public
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

JWT_SECRET=development_super_secret_jwt_key_at_least_32_chars_long_2026
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=development_super_secret_refresh_token_key_at_least_32_chars_2026
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=60

DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_STORAGE_PATH=uploads/documents
DOCUMENT_SIGNED_URL_EXPIRES_SECONDS=300
OCR_CONFIDENCE_THRESHOLD=0.7

NOTIFICATION_DEADLINE_THRESHOLDS=7,3,1,0
NOTIFICATION_RETENTION_DAYS=180
NOTIFICATION_CLEANUP_BATCH_SIZE=100
EMAIL_PROVIDER=LOG
EMAIL_FROM=notifications@smartschemes.gov.in
NOTIFICATION_MAX_EMAIL_RETRIES=3

AI_PROVIDER=MOCK
AI_MODEL=gemini-1.5-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000
AI_MAX_CONVERSATION_MESSAGES=20
AI_REQUESTS_PER_MINUTE=60
AI_CONVERSATION_RETENTION_DAYS=90

ANALYTICS_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
ANALYTICS_MAX_EXPORT_ROWS=10000
ANALYTICS_CACHE_TTL_SECONDS=300

VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_PORTAL_NAME=Smart Scheme & Scholarship Recommendation Portal (Dev)
VITE_APP_ENV=development
