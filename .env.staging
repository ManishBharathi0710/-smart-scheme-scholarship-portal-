# Staging Environment Configuration
NODE_ENV=staging
PORT=5001
API_PREFIX=/api/v1
DATABASE_URL=postgresql://staging_user:staging_password@staging-db.internal:5432/smart_scheme_staging?schema=public
FRONTEND_URL=https://staging.smartschemes.gov.in
CORS_ORIGINS=https://staging.smartschemes.gov.in
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

JWT_SECRET=staging_vault_secured_jwt_secret_min_64_characters_placeholder_2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=staging_vault_secured_refresh_secret_min_64_characters_placeholder
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=60

DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_STORAGE_PATH=/var/data/smart_schemes/documents
DOCUMENT_SIGNED_URL_EXPIRES_SECONDS=300
OCR_CONFIDENCE_THRESHOLD=0.7

NOTIFICATION_DEADLINE_THRESHOLDS=7,3,1,0
NOTIFICATION_RETENTION_DAYS=180
NOTIFICATION_CLEANUP_BATCH_SIZE=100
EMAIL_PROVIDER=LOG
EMAIL_FROM=staging-notifications@smartschemes.gov.in
NOTIFICATION_MAX_EMAIL_RETRIES=3

AI_PROVIDER=MOCK
AI_MODEL=gemini-1.5-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000
AI_MAX_CONVERSATION_MESSAGES=20
AI_REQUESTS_PER_MINUTE=30
AI_CONVERSATION_RETENTION_DAYS=90

ANALYTICS_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
ANALYTICS_MAX_EXPORT_ROWS=10000
ANALYTICS_CACHE_TTL_SECONDS=300

VITE_API_BASE_URL=https://staging.smartschemes.gov.in/api/v1
VITE_PORTAL_NAME=Smart Scheme & Scholarship Recommendation Portal (Staging)
VITE_APP_ENV=staging
