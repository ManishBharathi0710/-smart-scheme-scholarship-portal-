# Production Environment Configuration
# Note: Inject real secrets via AWS Secrets Manager, HashiCorp Vault, or hosting platform environment variables.
NODE_ENV=production
PORT=5001
API_PREFIX=/api/v1
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}?sslmode=require&schema=public
DATABASE_POOL_MIN=4
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT_MS=10000
FRONTEND_URL=https://smartschemes.gov.in
CORS_ORIGINS=https://smartschemes.gov.in
LOG_LEVEL=warn
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

JWT_SECRET=${PROD_JWT_SECRET}
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=${PROD_REFRESH_TOKEN_SECRET}
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30

DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_STORAGE_PATH=/var/data/smart_schemes/documents
DOCUMENT_SIGNED_URL_EXPIRES_SECONDS=300
OCR_CONFIDENCE_THRESHOLD=0.75

NOTIFICATION_DEADLINE_THRESHOLDS=7,3,1,0
NOTIFICATION_RETENTION_DAYS=180
NOTIFICATION_CLEANUP_BATCH_SIZE=100
EMAIL_PROVIDER=SMTP
EMAIL_FROM=official@smartschemes.gov.in
NOTIFICATION_MAX_EMAIL_RETRIES=3

AI_PROVIDER=GEMINI
AI_MODEL=gemini-1.5-flash
AI_API_KEY=${PROD_AI_API_KEY}
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000
AI_MAX_CONVERSATION_MESSAGES=20
AI_REQUESTS_PER_MINUTE=30
AI_CONVERSATION_RETENTION_DAYS=90

ANALYTICS_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
ANALYTICS_MAX_EXPORT_ROWS=10000
ANALYTICS_CACHE_TTL_SECONDS=300

VITE_API_BASE_URL=https://smartschemes.gov.in/api/v1
VITE_PORTAL_NAME=Smart Scheme & Scholarship Recommendation Portal
VITE_APP_ENV=production
